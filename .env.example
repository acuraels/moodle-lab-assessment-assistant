# Copy to .env in the repository root. Never commit .env or put JWTs here.
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080/
# Public build flag, not an authentication bypass. Rebuild frontend after changing.
VITE_ENABLE_TEST_LOGIN=true

# Existing PostgreSQL volume: do not rename or recreate during migration.
POSTGRES_VOLUME_NAME=backend_postgres_data
POSTGRES_DB=lab_assessment
# For an existing volume use the ACTUAL existing credentials, not new passwords.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Internal Docker hostname; URL-encode special characters in username/password.
DATABASE_URL=

# Keep existing secrets when migrating. For a new installation generate strong values.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LTI_CONSUMER_KEY=
LTI_CONSUMER_SECRET=
MAX_FILE_SIZE_BYTES=20971520

# Linux backend -> local ML container (--profile ml) -> Windows Ollama.
# For a separately hosted ML service, replace with its URL; empty means ML_NOT_CONFIGURED.
ML_URL=http://ml:8001
# Optional shared token, identical on backend and ML. Keep the real value in .env.
ML_TOKEN=
ML_TIMEOUT_SECONDS=540
ML_MAX_ATTEMPTS=2
ML_RETRY_DELAY_SECONDS=10
ML_PROCESSING_DEADLINE_SECONDS=1800

# CPU-only ML container; Ollama on Windows performs model inference.
OLLAMA_URL=http://100.81.179.101:11434
ML_BIND_ADDRESS=127.0.0.1
ML_PORT=8001
ML_CONTEXT_TOKENS=8192
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Only used by the optional --profile ollama runtime. For that setup,
# set OLLAMA_URL=http://ollama:11434 and enable both profiles.
OLLAMA_IMAGE=ollama/ollama:0.40.15
ML_MODEL_TIMEOUT_SECONDS=180
# Optional container path, after populating ml_tokenizer_cache (see deployment guide).
ML_TOKENIZER_PATH=
