# Copy to .env in the repository root. Never commit .env or put JWTs here.
FRONTEND_PORT=8080
FRONTEND_URL=http://localhost:8080/
# Public build flag, not an authentication bypass. Rebuild frontend after changing.
VITE_ENABLE_TEST_LOGIN=true

# Existing PostgreSQL volume: do not rename or recreate during migration.
POSTGRES_VOLUME_NAME=backend_postgres_data
POSTGRES_DB=lab_assessment
# For an existing volume use the ACTUAL existing credentials, not new passwords.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
# Internal Docker hostname; URL-encode special characters in username/password.
DATABASE_URL=

# Keep existing secrets when migrating. For a new installation generate strong values.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
LTI_CONSUMER_KEY=
LTI_CONSUMER_SECRET=
MAX_FILE_SIZE_BYTES=20971520
