# Public browser setting. Never put JWTs or secrets in VITE_ variables.
VITE_API_BASE_URL=/api
# Used only by the Vite dev/preview server, not shipped to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000
# Public build flag for a temporary real-JWT login form outside Vite dev mode.
VITE_ENABLE_TEST_LOGIN=false
