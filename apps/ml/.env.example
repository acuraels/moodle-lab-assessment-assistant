# On the Windows machine. Backend uses ML_URL pointing to this service, not Ollama.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Optional: use the same generated value in backend ML_TOKEN. Never commit it.
ML_TOKEN=
ML_MODEL_TIMEOUT_SECONDS=180
ML_QUEUE_TIMEOUT_SECONDS=5
ML_EXTRACTION_TIMEOUT_SECONDS=20
ML_UPLOAD_TIMEOUT_SECONDS=120
ML_CONTEXT_TOKENS=8192
ML_OUTPUT_TOKENS=2048
ML_CONTEXT_MARGIN_TOKENS=512
# Optional exact tokenizer for this model. Without it UTF-8 byte counting is conservative.
# ML_TOKENIZER_PATH=C:/models/qwen3-4b-instruct-2507/tokenizer.json
